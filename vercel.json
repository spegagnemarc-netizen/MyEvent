{
  "functions": {
    "api/create-payment-session.js": {
      "maxDuration": 30
    },
    "api/[search].js": {
      "maxDuration": 180
    },
    "api/camera-ai.js": {
      "maxDuration": 180
    },
    "api/search-places.js": {
      "maxDuration": 60,
      "includeFiles": "lib/venue-pdf-worker.js"
    }
  },
  "routes": [
    {
      "src": "^/server/restaurant-information\\.js$",
      "status": 404
    },
    {
      "src": "^/api/integration-venues$",
      "dest": "/api/search-places?restaurant_information=1"
    },
    {
      "src": "^/server/orevami-restaurants\\.js$",
      "status": 404
    },
    {
      "src": "^/server/ads-handler\\.js$",
      "status": 404
    },
    {
      "src": "^/server/search-(accommodation|transport)\\.js$",
      "status": 404
    },
    {
      "src": "^/server/sabre-admin-(diagnostic\\.js|policy\\.json)$",
      "status": 404
    },
    {
      "src": "^/suppression-compte$",
      "dest": "/delete-account.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/api/runtime-config$",
      "dest": "/api/camera-ai?runtime_config=1"
    },
    {
      "src": "^/$",
      "dest": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "fix/restaurant-v2-v3-restore-20261026": false,
      "fix/restaurant-parity-20261027": false,
      "fix/restaurant-sheet-information-20261027": false
    }
  }
}
