{
  "functions": {
    "api/camera-ai.js": {
      "maxDuration": 180
    },
    "api/search-places.js": {
      "maxDuration": 60,
      "includeFiles": "lib/venue-pdf-worker.js"
    }
  },
  "routes": [
    {
      "src": "^/api/integration-venues$",
      "dest": "/api/search-places?integration_venues=1"
    },
    {
      "src": "^/server/search-(accommodation|transport)\\.js$",
      "status": 404
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/api/runtime-config$",
      "dest": "/api/camera-ai?runtime_config=1"
    },
    {
      "src": "^/api/feed-post-deletion$",
      "dest": "/api/camera-ai?feed_post_delete=1"
    },
    {
      "src": "^/api/event-deletion$",
      "dest": "/api/camera-ai?event_delete=1"
    },
    {
      "src": "^/$",
      "dest": "/index.html"
    }
  ]
}
