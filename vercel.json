{
  "functions": {
    "api/create-payment-session.js": {"maxDuration":30},
    "api/[search].js": {
      "maxDuration": 180
    },
    "api/camera-ai.js": {
      "maxDuration": 180
    }
  },
  "routes": [
    {"src":"^/server/ads-handler\\.js$","status":404},
    {
      "src": "^/server/search-(accommodation|transport)\\.js$",
      "status": 404
    },
    {
      "src": "^/server/sabre-admin-(diagnostic\\.js|policy\\.json)$",
      "status": 404
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/api/runtime-config$",
      "dest": "/api/camera-ai?runtime_config=1"
    },
    {
      "src": "^/$",
      "dest": "/index.html"
    }
  ]
}
