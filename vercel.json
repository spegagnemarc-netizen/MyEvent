{
  "functions": {
    "api/camera-ai.js": {
      "maxDuration": 180
    },
    "api/create-payment-session.js": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "^/server/ads-handler\\.js$",
      "status": 404
    },
    {
      "src": "^/server/search-(accommodation|transport)\\.js$",
      "status": 404
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/api/runtime-config$",
      "dest": "/api/camera-ai?runtime_config=1"
    },
    {
      "src": "^/api/event-deletion$",
      "dest": "/api/camera-ai?event_delete=1"
    },
    {
      "src": "^/$",
      "dest": "/index.html"
    }
  ]
}
