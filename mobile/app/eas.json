{
  "build": {
    "release-private": {
      "developmentClient": false,
      "distribution": "internal",
      "env": {
        "MYEVENT_BUILD_PROFILE": "release"
      },
      "android": {
        "buildType": "apk",
        "withoutCredentials": true
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "developmentClient": false,
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "MYEVENT_BUILD_PROFILE": "release",
        "OREVAMI_DISTRIBUTION": "store",
        "EXPO_PUBLIC_MYEVENT_WEB_URL": "https://orevami.com"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "cli": {
    "appVersionSource": "remote"
  }
}
