{
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "developmentClient": false,
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "MYEVENT_BUILD_PROFILE": "release",
        "OREVAMI_DISTRIBUTION": "store",
        "EXPO_PUBLIC_MYEVENT_WEB_URL": "https://orevami.com"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "credentialsSource": "remote"
    },
    "private-test": {
      "developmentClient": false,
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "MYEVENT_BUILD_PROFILE": "release",
        "OREVAMI_DISTRIBUTION": "private"
      },
      "android": {
        "buildType": "apk",
        "image": "latest"
      },
      "ios": {
        "simulator": false,
        "image": "latest"
      },
      "credentialsSource": "remote",
      "node": "24.19.0"
    },
    "store-candidate": {
      "extends": "production"
    }
  },
  "cli": {
    "appVersionSource": "remote"
  }
}
