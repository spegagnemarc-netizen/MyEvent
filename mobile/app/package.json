{
  "name": "myevent-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start",
    "start:test": "node scripts/start-test.mjs",
    "android": "expo run:android --device",
    "ios": "expo run:ios --device",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "prepare:test-build": "node scripts/prepare-test-build.mjs",
    "typecheck": "tsc --noEmit",
    "export:android": "expo export --platform android --output-dir dist-android",
    "export:ios": "expo export --platform ios --output-dir dist-ios",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "expo": "57.0.26",
    "expo-camera": "57.0.6",
    "expo-dev-client": "57.0.19",
    "expo-file-system": "57.0.7",
    "expo-image-manipulator": "57.0.20",
    "expo-image-picker": "57.0.20",
    "expo-sensors": "57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-system-ui": "57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "19.2.4",
    "typescript": "6.0.3",
    "jsdom": "30.1.1"
  }
}
