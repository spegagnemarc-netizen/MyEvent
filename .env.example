# Development only: never copy production credentials. Set in Vercel by scope.
MYEVENT_ENV=development
SUPABASE_URL=https://<test-project-ref>.supabase.co
# Public application identifier, NOT a server secret. Only sb_publishable_ accepted.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<test-public-key>
MYEVENT_TEST_SUPABASE_REF=<test-project-ref>
# Server-only optional credentials are configured separately; no real values here.
# Do not enable Stripe/webhooks/paid external providers for the Admin test run.
